{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odysseus Shell",
  "mainBinaryName": "odysseus-shell",
  "version": "0.2.5",
  "identifier": "app.odysseus.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "publisher": "Odysseus Shell contributors",
    "shortDescription": "Native shell for self-hosted Odysseus",
    "longDescription": "A lightweight native desktop shell for any self-hosted Odysseus AI workspace. Connect to your instance over Tailscale or LAN, keep logins per-instance, minimize to tray (opt-in), and enjoy theme-matched window chrome."
  }
}
